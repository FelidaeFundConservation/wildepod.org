# ==============================================================================
# MINIMAL .env FOR LOCAL DEVELOPMENT (config.settings.local)
# ==============================================================================
# This is a minimal configuration for running the server locally WITHOUT GCP.
# Copy this to .env and update the values as needed.
#
# To run: python manage.py runserver --settings=config.settings.local
#
# Features that will work:
# - Basic Django server
# - Local PostgreSQL database
# - Local file storage (media/ directory)
# - Admin interface
# - User authentication
#
# Features that will NOT work without GCP setup:
# - ML inference (MegaDetector, Species Detector)
# - Datastore-based annotation queues
# - Google Cloud Storage
# - Export jobs (Cloud Tasks)
# ==============================================================================

# Required - Generate your own secret key for local development
DJANGO_SECRET_KEY=your-local-secret-key-here-change-this-to-something-random

# Optional - Admin URL customization
ADMIN_URL_SUFFIX=

# Optional - Allow user registration
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Update these to match your local PostgreSQL setup
# See config/settings/local.py for the database configuration
# Default:
#   Database: db.postgresql
#   User: postgres
#   Password: { YOUR_PASSWORD }
#   Host: 127.0.0.1
#   Port: 5432

# ==============================================================================
# OPTIONAL: Dropbox Configuration (for testing Dropbox integration)
# ==============================================================================
# DROPBOX_APP_KEY_STAGING=your-dropbox-app-key
# DROPBOX_APP_SECRET_STAGING=your-dropbox-app-secret
# DROPBOX_REFRESH_TOKEN_STAGING=your-dropbox-refresh-token

# ==============================================================================
# OPTIONAL: GCP Configuration (only if you need GCP features locally)
# ==============================================================================
# Real values are NOT stored in this file. See CONFIGURATION.md for where to
# find/store the real project ID, service URLs, and other GCP identifiers.
#
# Uncomment and fill in from your team's shared configuration:
#
# GOOGLE_CLOUD_PROJECT=<YOUR-PROJECT-ID>
# MEGADETECTOR_URL=https://<your-cloud-run-service>-<hash>-wl.a.run.app
# SPECIES_DETECTOR_URL=https://<region>-<YOUR-PROJECT-ID>.cloudfunctions.net/<your-function-name>
# GS_MODELS_BUCKET_NAME=<your-project-models-bucket>
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# EXPORT_URL_SUFFIX=<value-from-gcp-secret-manager>
