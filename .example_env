DJANGO_SECRET_KEY=ASJAbnmwetwiwogsdgnwpodjfdnsfrekjerkjfsnmsnfkjsfhjsekgfskdjfkdswbmbffdfdddw
ADMIN_URL_SUFFIX=-DUMMYSUFFIX
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False

# ==============================================================================
# LOCAL DEVELOPMENT WITHOUT GCP
# ==============================================================================
# For local development (config.settings.local), you only need:
# - DJANGO_SECRET_KEY (above)
# - Local PostgreSQL database credentials (see config/settings/local.py)
# - Optionally: Dropbox credentials if you need to test Dropbox integration
#
# The following GCP-related variables are OPTIONAL for local development.
# They are only needed if you want to test GCP-dependent features:
# - GOOGLE_CLOUD_PROJECT (for Datastore, Secret Manager)
# - MEGADETECTOR_URL, SPECIES_DETECTOR_URL (for ML inference)
# - GS_MODELS_BUCKET_NAME (for model storage)
# - GS_BUCKET_NAME_* (for cloud storage)
# - GOOGLE_MAPS_API_KEY (for maps)
#
# Local settings use local file storage (media/ directory) instead of GCS.
# ML inference and Datastore features will error if attempted without GCP setup.

# ==============================================================================
# GCP CONFIGURATION (Required for prod/staging/dev, optional for local)
# ==============================================================================
# Real values are NOT stored in this file. See CONFIGURATION.md for where to
# find/store the real project ID, service URLs, and other GCP identifiers.
GOOGLE_CLOUD_PROJECT=<YOUR-PROJECT-ID>

# ML Model Inference URLs (optional for local)
MEGADETECTOR_URL=https://<your-cloud-run-service>-<hash>-wl.a.run.app
SPECIES_DETECTOR_URL=https://<region>-<YOUR-PROJECT-ID>.cloudfunctions.net/<your-function-name>
GS_MODELS_BUCKET_NAME=<your-project-models-bucket>

# Cloud Storage Buckets (optional for local)
GS_BUCKET_NAME_PROD=<your-project-prod-bucket>
GS_BUCKET_NAME_STAGING=<your-project-staging-bucket>
GS_BUCKET_NAME_DEV=<your-project-dev-bucket>

# ==============================================================================
# DATABASE URLS (Environment-specific)
# ==============================================================================
PROD_DATABASE_URL=******//cloudsql/<YOUR-PROJECT-ID>:<region>:<YOUR-DB-INSTANCE>/prod
STAGING_DATABASE_URL=******//cloudsql/<YOUR-PROJECT-ID>:<region>:<YOUR-DB-INSTANCE>/staging

# ==============================================================================
# EXPORT SERVICE
# ==============================================================================
# This token is part of the URL path for the internal export job trigger endpoint.
# It acts as a shared secret — keep it out of source code.
# Stored in: GCP Secret Manager as part of the django_settings secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(18))"
EXPORT_URL_SUFFIX=DUMMYTOKENDUMMYTOKEN

# ==============================================================================
# DROPBOX CONFIGURATION (Optional)
# ==============================================================================
DROPBOX_APP_KEY_STAGING=DUMMYKEYDUMMYKEY
DROPBOX_APP_SECRET_STAGING=DUMMYSECRET
DROPBOX_REFRESH_TOKEN_STAGING=DUMMYTOKENDUMMYTOKENDUMMYTOKENDUMMYTOKEN
DROPBOX_APP_KEY_PROD=DUMMYKEYDUMMYKEY
DROPBOX_APP_SECRET_PROD=DUMMYSECRET
DROPBOX_REFRESH_TOKEN_PROD=DUMMYTOKENDUMMYTOKENDUMMYTOKENDUMMYTOKEN

# ==============================================================================
# EMAIL CONFIGURATION (Optional)
# ==============================================================================
SENDGRID_API_KEY=DUMMYTOKENDUMMYTOKENDUMMYTOKENDUMMYTOKEN
